{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Silk",
  "scopeName": "source.silk",
  "fileTypes": [
    "silk"
  ],
  "patterns": [
    {
      "include": "#comments"
    },
    {
      "include": "#strings"
    },
    {
      "include": "#numbers"
    },
    {
      "include": "#keywords"
    },
    {
      "include": "#operators"
    },
    {
      "include": "#punctuation"
    }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.number-sign.silk",
          "match": "#.*$"
        }
      ]
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.double.silk",
          "begin": "\"",
          "end": "\"",
          "patterns": [
            {
              "name": "constant.character.escape.silk",
              "match": "\\\\."
            }
          ]
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.integer.silk",
          "match": "\\b\\d+\\b"
        },
        {
          "name": "constant.numeric.float.silk",
          "match": "\\b\\d+\\.\\d+\\b"
        }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "name": "keyword.control.silk",
          "match": "\\b(?:import|var|func|const|as|for|while|and|or|if|else|null|return|global|struct|in|true|false)\\b"
        },
        {
          "name": "storage.type.silk",
          "match": "\\b(?:int|float|bool|string|list|object|void)\\b"
        }
      ]
    },
    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.silk",
          "match": "[=+\\-*/%<>!]+"
        }
      ]
    },
    "punctuation": {
      "patterns": [
        {
          "name": "punctuation.separator.silk",
          "match": "[.,;]"
        },
        {
          "name": "punctuation.section.brackets.silk",
          "match": "[(){}\\[\\]]"
        }
      ]
    }
  }
}
