import "io"

print("Io print!")
write("io_test_write.txt", "Test content line 1\n")
print("reading from test file: ")
print(read("io_test_write.txt"))
append("io_test_write.txt", "Test content line 2\n")
print("File after append:")
print(read("io_test_write.txt"))
print("File exists: ", exists("io_test_write.txt"))
print("Nonexistent file exists: ", exists("nonexistent.txt"))

print("Making file object")
var file = File("io_test_write.txt")
file.cursor(999)
file.writeline("line 1")
print("File after writeline")
for line in file.getlines() {
    print(line)
}
file.write("line 2")
print("File after write")
for line in file.getlines() {
    print(line)
}

file.cursor(0)
print(file.getline())
delete("io_test_write.txt")
print("File exists after delete: ", exists("io_test_write.txt"))

var list = ["hello", "world"]
print(list.len())
print(list.contains("hello"))
print(list.contains("foo"))
print(list.index_of("world"))
print(list.index_of("bar"))
var sliced = list.slice(0, 1)
print(sliced.len())
var with_item = list.push("!")
print(with_item.len())
var nums = [1, 2, 3, 4, 5]
print(nums.len())
var popped = nums.pop()
print(popped.len())
print(nums.first())
print(nums.last())
var reversed = nums.reverse()
print(reversed.len())
var with_dupes = ["a", "b", "a", "c", "a"]
print(with_dupes.count("a"))
print(with_dupes.count("b"))
print(with_dupes.count("z"))

